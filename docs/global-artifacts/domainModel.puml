@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false
skinparam classAttributeIconSize 0
hide circle
hide methods

title Domain Model - Train Station Warehouse (Sprint 1) - Improved

' --- CORE ENTITIES ---
class Warehouse {
    warehouseId
}

class Aisle {
    aisleNumber
}

class Bay {
    bayNumber
    capacityBoxes
}

class Box {
    boxId
    sku
    qty
    expiryDate
    receivedAt
}

class Item {
    sku
    name
    category
    unit
    volume
    unitWeight
}

class Wagon {
    wagonId
    type
    gauge
    payloadCapacity
    tareWeight
}

class Locomotive {
    number
    name
    yearOfEntry
    type
    model
    make
    power
    maxSpeed
    weight
    width
    height
    lenght
    gauge
    BogiesNumber
}

class Train {
    trainId
}

class DieselTrain {
    fuelCapacity
}

class ElectricTrain {
    voltage
    frequency
}

class RailLine {
    lineId
    name
    owner
    gauge
}

class LineSegment {
    segmentId
    trackType
    gauge
    maxWeight
    speedLimit
    length
    isElectrified
}

class Endpoint {
    endpointId
    name
    type
}

class Operator {
    operatorId
    name
}

class Order {
    orderId
    dueDate
    priority
}

class OrderLine {
    lineNo
    qty
    status
}

class Allocation {
    allocatedQty
}

class Return {
    returnId
    qty
    reason
    timestamp
    status
}

class Quarantine {
}


class User {
    userId
    name
    email
}



' --- RELATIONSHIPS ---
Warehouse "1" -- "*" Aisle : contains
Aisle "1" -- "*" Bay : contains
Bay "1" -- "*" Box : stores
Box "1" -- "1" Item : references
Wagon "1" -- "*" Box : transports
Wagon "0..*" -- "1" Operator : belongsTo
Locomotive "0..*" -- "1" Operator : belongsTo
Train "1" -- "1..*" Locomotive : pulledBy
Train "1" -- "*" Wagon : carries
Train "0..*" -- "1" Operator : operatedBy
RailLine "1" -- "*" LineSegment : composedOf
LineSegment "1" -- "1" Endpoint : startsAt
LineSegment "1" -- "1" Endpoint : endsAt
RailLine "1" -- "1" Operator : ownedBy
ElectricTrain "*" -- "*" LineSegment : requiresElectrified
Order "1" -- "*" OrderLine : contains
OrderLine "1" -- "*" Allocation : has
Allocation "1" -- "1" Box : from
Return "1" -- "1" Item : references
Quarantine "1" -- "*" Return : holds
Endpoint "1" -- "*" Warehouse : has

' --- USER RESPONSIBILITIES ---
Planner "1" -- "*" Order : creates
Planner "1" -- "*" Allocation : manages
StorageManager "1" -- "*" Warehouse : manages
StorageManager "1" -- "*" Box : handles
QualityOperator "1" -- "*" Return : inspects
QualityOperator "1" -- "*" Quarantine : manages
TrainDriver "1" -- "*" Train : operates
StationMaster "1" -- "*" Endpoint : supervises
FreightManager "1" -- "*" Wagon : coordinates

' --- INHERITANCE ---
Train <|-- ElectricTrain
Train <|-- DieselTrain
User <|-- TrainDriver
User <|-- StationMaster
User <|-- StorageManager
User <|-- FreightManager
User <|-- Planner
User <|-- QualityOperator

@enduml