@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false
skinparam classAttributeIconSize 0
hide circle
hide methods

' --- CORE ENTITIES ---
class Warehouse {
    warehouseId
}

class Aisle {
    aisleNumber
}

class Bay {
    bayNumber
    capacityBoxes
    currentBoxes
}

class Box {
    boxId
    sku
    qty
    expiryDate
    receivedAt
}

class Item {
    sku
    name
    category
    unit
    volume
    unitWeight
}

class Wagon {
    wagonId
    type
    payloadCapacity
    volumeCapacity
    tareWeight
    weight
    width
    height
    length
    gauge
    BogiesNumber
}

class Trolley {
    trolleyId
    capacityWeight
    usedWeight
}

class PickingPlan {
    planId
    heuristic
}

' --- DOMÍNIO FERROVIÁRIO ATUALIZADO ---
class Locomotive {
    number
    name
    yearOfEntry
}

class LocomotiveModel {
    make
    power
    acceleration
    type
    maxWeight
    weight
    width
    height
    length
    gauge
    BogiesNumber
}

class Train {
    trainId
    currentStatus
    totalWeight
    requiredPower
}

class DieselTrain {
    fuelCapacity
}

class ElectricTrain {
    voltage
    frequency
}

class RailLine {
    lineId
    name
    gauge
}

class LineSegment {
    segmentId
    trackType
    gauge
    sequenceOrder
    maxWeight
    speedLimit
    length
    isElectrified
    hasSiding
}

class Endpoint {
    endpointId
    name
    type
}

class Operator {
    number
    name
}

' --- NOVAS ENTIDADES SPRINT 2 ---
class Freight {
    freightId
    status
    plannedDeparture
    estimatedArrival
}

class Route {
    routeId
    routeType
    scheduledDeparture
}

class Path {
    pathId
    sequenceOrder
}

class TrainRecord {
    recordId
    crossingTime
    arrivalTime
    departureTime
}

' --- GESTÃO DE ENCOMENDAS ---
class Order {
    orderId
    dueDate
    priority
}

class OrderLine {
    lineNo
    qty
    status
}

class Allocation {
    allocatedQty
}

class Return {
    returnId
    qty
    reason
    timestamp
    status
}

class Quarantine {
}

class User {
    userId
    role
}

' --- RELATIONSHIPS EXISTENTES ---
Warehouse "1" -- "*" Aisle : contains
Aisle "1" -- "*" Bay : contains
Bay "1" -- "*" Box : stores
Box "1" -- "1" Item : references
Wagon "1" -- "*" Box : transports
Wagon "0..*" -- "1" Operator : belongsTo
Locomotive "0..*" -- "1" Operator : belongsTo
Locomotive "1" -- "1" LocomotiveModel : has
Train "1" -- "1..*" Locomotive : contains
Train "1" -- "*" Wagon : carries
RailLine "1" -- "*" LineSegment : composedOf
LineSegment "2" -- "2" Endpoint : connects
RailLine "1" -- "1" Operator : ownedBy
ElectricTrain "*" -- "*" LineSegment : requires
Order "1" -- "*" OrderLine : contains
OrderLine "1" -- "*" Allocation : has
Allocation "1" -- "1" Box : from
Return "1" -- "1" Item : references
Quarantine "1" -- "*" Return : holds
Endpoint "1" -- "*" Warehouse : has
PickingPlan "1" -- "*" Trolley : uses
Trolley "*" -- "*" Allocation : picks

' --- NOVOS RELACIONAMENTOS SPRINT 2 ---
Freight "1" -- "*" Wagon : contains
Freight "1" -- "1" Endpoint : origin
Freight "1" -- "1" Endpoint : destination
Freight "1" -- "1" Train : transportedBy
Route "1" -- "*" Freight : contains
Route "1" -- "*" Path : defines
Path "1" -- "1" Endpoint : passesThrough
Train "1" -- "1" Route : assignedTo
Train "1" -- "*" TrainRecord : has
TrainRecord "1" -- "1" Endpoint : at

' --- USER RESPONSIBILITIES ---
Planner "1" -- "*" Order : creates
Planner "1" -- "*" Allocation : manages
Planner "1" -- "*" PickingPlan : creates
StorageManager "1" -- "*" Warehouse : manages
StorageManager "1" -- "*" Box : handles
QualityOperator "1" -- "*" Return : inspects
QualityOperator "1" -- "*" Quarantine : manages
TrainDriver "1" -- "*" Train : operates
StationMaster "1" -- "*" Endpoint : supervises
FreightManager "1" -- "*" Wagon : coordinates
FreightManager "1" -- "*" Freight : manages
FreightManager "1" -- "*" Route : plans

' --- INHERITANCE ---
Train <|-- ElectricTrain
Train <|-- DieselTrain
User <|-- TrainDriver
User <|-- StationMaster
User <|-- StorageManager
User <|-- FreightManager
User <|-- Planner
User <|-- QualityOperator

@enduml