###############################
# GERAL
###############################
# Arquivos de sistema
.DS_Store
Thumbs.db

# Logs e temporários
*.log
*.tmp
*.swp

###############################
# INTELLIJ IDEA / JETBRAINS
###############################
# Pasta de configuração local do IntelliJ (não partilhar)
.idea/workspace.xml
.idea/tasks.xml
.idea/usage.statistics.xml
.idea/dictionaries
.idea/httpRequests
.idea/shelf/
.idea/sonarlint/
.idea/gradle.xml
.idea/misc.xml
.idea/modules.xml
.idea/compiler.xml
.idea/libraries/

# Ficheiros de configuração individuais
*.iml
*.ipr
*.iws

###############################
# MAVEN / JAVA
###############################
# Pastas de compilação e artefactos
target/
*/target/
out/
bin/
build/
*.class
*.jar
*.war
*.ear
*.zip
*.tar.gz

# Relatórios de testes
surefire-reports/
test-output/

###############################
# SISTEMA OPERATIVO / IDE VARIADOS
###############################
# macOS
.AppleDouble
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

# Windows
ehthumbs.db
Desktop.ini

# VSCode (caso alguém use)
.vscode/

###############################
# ESPECÍFICO DO PROJETO
###############################
# Ignorar ficheiros locais do Maven Wrapper (se não usarem)
.mvn/
mvnw
mvnw.cmd

# SQL scripts de build são versionados, por isso NÃO ignorar sql-scripts/
# resources podem ser versionados também, então NÃO ignorar /res/
